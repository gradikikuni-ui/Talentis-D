# DATABASE_URL=postgresql://user:password@host:5432/talentis_d
DATABASE_URL=sqlite:///./talentis_d.db

SECRET_KEY=change-moi-avec-une-vraie-cle-secrete-aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=10080